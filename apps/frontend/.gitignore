*.iml
.gradle
/.gradle-user-home
/.idea
.DS_Store
/build
/captures
.externalNativeBuild
.cxx

# ──────────────────────────────────────────────
# 🔐 보안 파일 (절대 커밋 금지)
# ──────────────────────────────────────────────

# 로컬 환경 설정 (SDK 경로, API 키 등)
local.properties
/local.properties

# iOS 로컬 환경 설정 (Google Client ID 등 민감 정보)
CashChatIOS/local.xcconfig

# iOS 민감 값 파일 (Secrets.swift.example을 복사해서 실제 값 입력)
CashChatIOS/CashChatIOS/Secrets.swift

# Firebase 설정 파일 (CI에서 secret으로 주입)
**/google-services.json
**/GoogleService-Info.plist
service-account.json

# Android 릴리즈 서명 키
*.keystore
*.jks
key.properties

# ──────────────────────────────────────────────
# 빌드 산출물 (재생성 가능)
# ──────────────────────────────────────────────
shared/build/

# KMM 빌드 캐시
.kotlin/

# Xcode 빌드 산출물 (xcodebuild DerivedData 등)
CashChatIOS/build/

# Xcode 사용자 설정 / SwiftPM 캐시
CashChatIOS/**/*.xcodeproj/xcuserdata/
CashChatIOS/**/*.xcworkspace/xcuserdata/
CashChatIOS/**/*.xcworkspace/xcshareddata/swiftpm/

# ──────────────────────────────────────────────
# 주석
# ──────────────────────────────────────────────
#  - /.gradle, /.gradle-user-home: Gradle 캐시/다운로드 파일 (재생성 가능)
#  - /.idea, *.iml: Android Studio/IntelliJ 개인 IDE 설정 (팀 공용 소스 아님)
#  - /build, .externalNativeBuild, .cxx: 빌드 산출물/중간 파일 (빌드시 다시 생성)
#  - /captures, .DS_Store: 스크린샷/OS 메타파일
#  - local.properties: 로컬 SDK 경로/API 키 (보안 + 환경별 차이로 미커밋)
#  - google-services.json: Firebase 프로젝트 설정 (CI에서 secret으로 주입)
#  - service-account.json: Firebase Admin SDK 서비스 계정 키 (CI에서 secret으로 주입)
#  - *.keystore / key.properties: Android 릴리즈 서명 키 (CI에서 secret으로 주입)