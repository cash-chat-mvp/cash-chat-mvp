default_platform(:android)

# ─────────────────────────────────────────────────────────────────────────────
# Android — Firebase App Distribution
# ─────────────────────────────────────────────────────────────────────────────
platform :android do
  desc "Build release APK and distribute to Firebase App Distribution"
  lane :distribute do
    gradle(
      task: "assemble",
      build_type: "Release",
      properties: {
        "android.injected.signing.store.file"     => ENV.fetch("KEYSTORE_PATH"),
        "android.injected.signing.store.password" => ENV.fetch("KEYSTORE_STORE_PASSWORD"),
        "android.injected.signing.key.alias"      => ENV.fetch("KEYSTORE_KEY_ALIAS"),
        "android.injected.signing.key.password"   => ENV.fetch("KEYSTORE_KEY_PASSWORD"),
        "android.injected.version.name"           => ENV.fetch("VERSION_NAME"),
        "android.injected.version.code"           => ENV.fetch("VERSION_CODE"),
      }
    )

    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_APP_ID"),
      service_credentials_file: "service-account.json",
      release_notes: ENV.fetch("RELEASE_NOTES", "New build available"),
      groups: "testers"
    )
  end
end

# ─────────────────────────────────────────────────────────────────────────────
# iOS — TestFlight
# ─────────────────────────────────────────────────────────────────────────────
platform :ios do
  desc "Build iOS app and upload to TestFlight"
  lane :distribute do
    api_key = app_store_connect_api_key(
      key_id:      ENV.fetch("ASC_API_KEY_ID"),
      issuer_id:   ENV.fetch("ASC_API_ISSUER_ID"),
      key_content: ENV.fetch("ASC_API_KEY_CONTENT"),
    )

    version_match = ENV.fetch("VERSION_NAME").match(/\A\d+\.\d+\.\d+/)
    UI.user_error!("VERSION_NAME must start with X.Y.Z format, got: #{ENV.fetch('VERSION_NAME')}") unless version_match
    clean_version = version_match[0]

    increment_version_number(
      version_number: clean_version,
      xcodeproj: "CashChatIOS/CashChatIOS.xcodeproj"
    )

    # TestFlight에 이미 올라간 최신 빌드 번호 조회 → 항상 그보다 높은 번호 사용
    # 이전 배포가 업로드 성공 후 배포 실패한 경우에도 빌드 번호 충돌 방지
    computed_build = ENV.fetch("VERSION_CODE").to_i
    begin
      latest_tf_build = latest_testflight_build_number(
        api_key:              api_key,
        app_identifier:       ENV.fetch("IOS_BUNDLE_ID"),
        initial_build_number: computed_build - 1
      )
      build_number = [computed_build, latest_tf_build + 1].max
      UI.message("TestFlight 최신 빌드: #{latest_tf_build} → 사용 빌드 번호: #{build_number}")
    rescue => e
      UI.important("TestFlight 빌드 번호 조회 실패: #{e.message} — VERSION_CODE 사용")
      build_number = computed_build
    end

    increment_build_number(
      build_number: build_number,
      xcodeproj: "CashChatIOS/CashChatIOS.xcodeproj"
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  "CashChatIOS/CashChatIOS.xcodeproj",
      code_sign_identity:    "Apple Distribution",
      profile_name:          ENV.fetch("PROVISIONING_PROFILE_NAME"),
      team_id:               ENV.fetch("IOS_DEVELOPMENT_TEAM_ID"),
    )

    build_app(
      project:          "CashChatIOS/CashChatIOS.xcodeproj",
      scheme:           "CashChatIOS",
      export_method:    "app-store",
      clean:            true,
      output_directory: "build",
      output_name:      "CashChatIOS.ipa",
    )

    # beta_app_description은 앱 단위 메타데이터(외부 Beta App Review 심사용 "앱 설명")로,
    # 빌드마다 바뀌는 릴리즈 노트(changelog)와 성격이 다르다. AI가 생성한 노트에는
    # 이모지·마크다운이 섞여 BetaAppLocalization.description 엔드포인트가 거부하므로
    # ("invalid characters/formats"), 고정 평문 앱 설명을 별도로 사용한다.
    beta_app_description = ENV["BETA_APP_DESCRIPTION"].to_s.strip
    if beta_app_description.empty?
      beta_app_description = "Cash Chat은 AI 채팅 기반의 모바일 앱입니다. " \
        "채팅으로 정보를 주고받고 활동에 따라 리워드를 받을 수 있습니다."
    end

    # 외부 배포 여부와 대상 그룹은 환경변수로 제어한다(코드 수정 없이 GitHub Variables로 전환).
    # 미설정 시 내부 전용(CashChatPrivateTester)이 기본값.
    distribute_external = ENV["DISTRIBUTE_EXTERNAL"].to_s.strip.downcase == "true"
    groups = ENV["TESTFLIGHT_GROUPS"].to_s.split(",").map(&:strip).reject(&:empty?)
    groups = ["CashChatPrivateTester"] if groups.empty?

    # 외부 배포(Beta App Review) 시 필수인 피드백 이메일. 값이 있을 때만 전달
    # (빈 값을 넘기면 동일하게 ASC 검증 오류가 발생).
    beta_feedback_email = ENV["BETA_APP_FEEDBACK_EMAIL"].to_s.strip
    if distribute_external && beta_feedback_email.empty?
      UI.user_error!("외부 배포(DISTRIBUTE_EXTERNAL=true)에는 BETA_APP_FEEDBACK_EMAIL이 필요합니다.")
    end

    testflight_params = {
      api_key:                           api_key,
      changelog:                         ENV.fetch("RELEASE_NOTES", "New build"),
      beta_app_description:              beta_app_description,
      skip_waiting_for_build_processing: false,
      distribute_external:               distribute_external,
      groups:                            groups,
    }
    testflight_params[:beta_app_feedback_email] = beta_feedback_email unless beta_feedback_email.empty?

    upload_to_testflight(**testflight_params)
  end
end
