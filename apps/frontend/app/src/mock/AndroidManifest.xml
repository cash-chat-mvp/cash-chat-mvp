<?xml version="1.0" encoding="utf-8"?>
<!--
  mock 플레이버 전용 매니페스트 오버레이.
  AdMob 의 MobileAdsInitProvider 는 Application.onCreate 보다 먼저 실행되며,
  APPLICATION_ID meta-data 가 비어 있으면(로컬에 ADMOB_APP_ID 미설정) 프로세스 시작 시 크래시한다.
  mock 은 실제 광고를 쓰지 않고 Fake presenter 로 대체하므로, 여기서 Google 공개 테스트
  App ID 로 대체해 크래시만 막는다(비밀값 불필요, hermetic 유지).
  https://developers.google.com/admob/android/test-ads
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"
            tools:replace="android:value" />
    </application>
</manifest>
