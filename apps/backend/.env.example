# AI Provider — 채팅 LLM 은 dev/prod 모두 Gemini(OpenAI 호환 엔드포인트)를 사용한다.
GEMINI_API_KEY=your-gemini-api-key

# OAuth: use a development client registered in Google Cloud Console.
# Authorized redirect URI: http://localhost:8080/api/auth/callback/google
GOOGLE_CLIENT_ID=google-client-id
GOOGLE_CLIENT_SECRET=google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/callback/google

# OAuth: Apple Sign in. Keep the private key in environment/secret storage only.
APPLE_CLIENT_ID=com.nomadclub.cashchat
APPLE_TEAM_ID=apple-team-id
APPLE_KEY_ID=apple-key-id
APPLE_PRIVATE_KEY=replace-with-escaped-p8-private-key
APPLE_REDIRECT_URI=
APPLE_TOKEN_URI=https://appleid.apple.com/auth/token
APPLE_JWKS_URI=https://appleid.apple.com/auth/keys

# JWT
JWT_SECRET=this-is-a-development-secret-key-at-least-32-bytes-long!!

# Google AdMob SSV
APP_ADS_GOOGLE_SSV_PUBLIC_KEYS_URI=https://www.gstatic.com/admob/reward/verifier-keys.json
APP_ADS_GOOGLE_PUBLIC_KEY_CACHE_TTL=24h
APP_ADS_GOOGLE_REWARDED_AD_UNIT_ID=
