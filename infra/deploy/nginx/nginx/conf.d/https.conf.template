server {
    listen 80;
    listen [::]:80;
    server_name __SERVER_NAMES__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __SERVER_NAMES__;

    ssl_certificate /etc/letsencrypt/live/__CERT_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT_NAME__/privkey.pem;

    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 20m;

    # Server-Sent Events stream for chat completions.
    # Buffering must be disabled so each SSE chunk is flushed to the client immediately.
    # The backend emits a heartbeat every 15s, so a 60s read timeout cleans up dead
    # connections quickly without cutting off a legitimately slow response.
    location = /api/v1/chat/stream {
        proxy_pass __BACKEND_UPSTREAM__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 60s;
    }

    # 온디바이스 Gemma 모델(.litertlm, ~2.5GB) 정적 서빙.
    # 외부 CDN(Cloudflare/HF)이 일부 모바일·IPv6 망에서 QUIC/연결 정체로 안 닿는 문제를
    # 우회한다 — 앱이 이미 정상 접속하는 이 백엔드 도메인에서 직접 내려준다.
    # nginx 정적 파일은 Range(이어받기)를 기본 지원하므로 다운로더의 resume 로직과 호환된다.
    location /models/ {
        alias /srv/models/;
        default_type application/octet-stream;
        sendfile on;
        tcp_nopush on;
        # 모델 파일은 불변 → 길게 캐시(클라/중간 캐시)
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        proxy_pass __BACKEND_UPSTREAM__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
