# Used by application-dev.yaml in frontend-local compose
APP_SWAGGER_ENABLED=true
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_CLIENT_ID=google-client-id
GOOGLE_CLIENT_SECRET=google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/callback/google

# Apple OAuth (CC-239)
APPLE_CLIENT_ID=com.nomadclub.cashchat
APPLE_TEAM_ID=apple-team-id
APPLE_KEY_ID=apple-key-id
# Store the P8 PEM as a single line by replacing real newlines with the two-character \n sequence.
# Example: APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGTAgEAMBMGByqGSM49...\n-----END PRIVATE KEY-----
APPLE_PRIVATE_KEY=replace-with-escaped-p8-private-key
APPLE_REDIRECT_URI=

# Google AdMob SSV
APP_ADS_GOOGLE_REWARDED_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
